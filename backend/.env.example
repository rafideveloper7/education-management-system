PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
# IANA time zone used to interpret attendance calendar dates (set to the school's zone).
ACADEMIC_TIME_ZONE=UTC
# Required to enable Group 12 file uploads; never expose these values to clients.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Comma-separated browser origins; required when NODE_ENV=production.
CLIENT_ORIGINS=
REDIS_URL=redis://127.0.0.1:6379
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
